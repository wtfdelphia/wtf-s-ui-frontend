+              <v-progress-circular size="12" width="2" indeterminate class="mr-1" />{{ $t('server.testing') }}
+            </v-chip>
+            <v-chip v-else-if="st(item).state === 'online'" size="small" color="success" variant="tonal" prepend-icon="mdi-check-circle">
+              {{ st(item).latency }} ms
+            </v-chip>
