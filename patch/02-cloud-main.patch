+// What api/checkOutbound answers with.
+interface CheckReply {
+  OK: boolean
+  Delay?: number
+  Error?: string
+}
+
+interface CheckResult {
+  loading?: boolean
+  success: boolean
+  data?: CheckReply | null
+  errorMessage?: string
