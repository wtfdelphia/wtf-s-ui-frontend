+    </v-row>
+    <template v-if="show">
+      <v-row>
+        <v-col
+          cols="12"
+          sm="6"
+          md="4"
+        >
+          <v-text-field
+            v-model="idleTimeout"
+            :label="$t('quic.idleTimeout')"
